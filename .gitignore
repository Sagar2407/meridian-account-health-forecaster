# Secrets and local overrides
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# JavaScript
node_modules/
frontend/node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Phase 0 verification helper cache
.phase0-cache/

# Embedding weights fastembed downloads when FASTEMBED_CACHE_PATH points here,
# as continuous integration sets it so the download can be cached between runs.
# Downloaded tool state, never source: 65 MB of ONNX that the repository scan
# would otherwise try to read as text.
.model-cache/

# IDE and operating system
.DS_Store
.idea/
.vscode/
# Scratch file dropped in the working tree by an external editor session; no
# code in this repository creates or reads it.
:memory:.ses

# Runtime-generated data and model artifacts
data/processed/
data/indexes/
# The deterministic account split IS committed: it is small, holds account ids
# only (never labels), and lets a reviewer reproduce every reported metric.
!data/splits/account_split.json
data/knowledge_base/*
data/rag_corpus/*
data/eval/*
!data/knowledge_base/.gitkeep
!data/rag_corpus/.gitkeep
!data/eval/.gitkeep
models/
# `artifacts/` IS committed. `docs/EVIDENCE_MAP.md` cites these files as the
# evidence behind every published number, and a citation to a path no clone
# contains is not evidence. The whole tree is small text plus a few plots (well
# under a megabyte); the genuinely large outputs it used to shield, the trained
# model and the FAISS index, are ignored above under `models/` and
# `data/indexes/` and are rebuilt with `make bootstrap`.
logs/
# Application state this system writes about itself: assessment snapshots,
# review cases, and LangGraph checkpoints (plan sections 12.2 and 17). It is
# per-deployment, not source, and a committed copy would put one machine's run
# history in every clone.
data/app/

# The source archive and extracted raw dataset are retained locally, not committed.
# The synthetic dataset is the author's own work, so the archive itself is
# committed: it is 4.2 MB, and it is the reference the byte-exact
# reproducibility test compares the regenerated tables against. The extracted
# copy under data/raw/ stays ignored -- it is 38 MB, 27.5 MB of which is
# re-serialized JSONL no code in this repository reads. See dataset/ for the
# generator source in browsable form.
data/raw/

# Working notes and drafts kept locally, not published. The implementation plan
# is published from `docs/`; the copy at the repository root is a scratch one.
*.docx
/Meridian_Autonomous_System_Implementation_Plan.md

# Generated by the frontend toolchain and the browser suite. None of it is
# source: TypeScript's incremental build state, Playwright's report and
# per-test artifacts, and the JSON reporter's output.
frontend/*.tsbuildinfo
frontend/e2e-results.json
frontend/test-results/
frontend/playwright-report/
