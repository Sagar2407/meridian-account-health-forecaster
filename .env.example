# Runtime
MERIDIAN_ENVIRONMENT=development
MERIDIAN_LOG_LEVEL=INFO
MERIDIAN_API_HOST=0.0.0.0
MERIDIAN_API_PORT=8000
MERIDIAN_CORS_ORIGINS=http://localhost:5173

# Browser-visible API location used by the Vite frontend.
VITE_API_BASE_URL=http://localhost:8000

# Keep real values in an untracked .env file or a deployment secret store.
# Language model (ADR 0004). Every phase through 4 runs with no key at all;
# only model-backed features need one. The base URL decides which service is
# called, so an OpenRouter key with an anthropic/* model reaches Claude.
MERIDIAN_LLM_PROVIDER=openai_compatible
MERIDIAN_LLM_MODEL=anthropic/claude-sonnet-4.5
MERIDIAN_LLM_BASE_URL=https://openrouter.ai/api/v1
MERIDIAN_LLM_API_KEY=
# How JSON is requested: auto | json_schema | json_object | prompt.
# `auto` asks for a server-enforced JSON Schema and steps down if the server
# refuses, which is what lets small open-weight models and local runtimes work.
# Correctness does not depend on it -- every reply is validated against the
# Pydantic model whichever mode produced it.
MERIDIAN_LLM_STRUCTURED_OUTPUT=auto
# To try the model-backed path for nothing, use a free open-weight slug:
#   MERIDIAN_LLM_MODEL=liquid/lfm-2.5-2.6b:free
# See artifacts/provider/README.md for a captured run on that model.

# Accepted as a second name for MERIDIAN_LLM_API_KEY, for continuity with
# earlier phases. Set only one of the two.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Serving and the public demo (plan sections 18.2 and 24.3) --------------
# Every one of these has a safe default; a local checkout needs none of them.

# Where the compiled browser bundle lives. Empty in development, where Vite
# serves the frontend on its own port. The production image sets it.
MERIDIAN_STATIC_DIRECTORY=

# Demo mode restricts assessments to the synthetic portfolio, replaces free
# text with a curated question, and refuses portfolio scans and evaluations.
MERIDIAN_DEMO_MODE=false

# Runs one client may start per hour, and the whole service per day. 0 disables.
MERIDIAN_RATE_LIMIT_RUNS_PER_HOUR=60
MERIDIAN_RATE_LIMIT_DAILY_RUNS=500

# Bounded portfolio scan.
MERIDIAN_SCAN_CONCURRENCY=4
MERIDIAN_SCAN_MAX_ACCOUNTS=50
MERIDIAN_SCAN_RENEWAL_HORIZON_DAYS=120
MERIDIAN_SCAN_MODEL_CALL_BUDGET=200

# The scheduled worker is opt-in and refuses to run in demo mode.
MERIDIAN_ENABLE_SCHEDULER=false
MERIDIAN_SCHEDULER_INTERVAL_MINUTES=1440

# Optional LangSmith mirroring (plan section 21.2). The application is fully
# functional with this off.
LANGSMITH_TRACING=false
