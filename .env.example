# Runtime
MERIDIAN_ENVIRONMENT=development
MERIDIAN_LOG_LEVEL=INFO
MERIDIAN_API_HOST=0.0.0.0
MERIDIAN_API_PORT=8000
MERIDIAN_CORS_ORIGINS=http://localhost:5173

# Browser-visible API location used by the Vite frontend.
VITE_API_BASE_URL=http://localhost:8000

# Keep real values in an untracked .env file or a deployment secret store.
# Language model (ADR 0004). Every phase through 4 runs with no key at all;
# only model-backed features need one. The base URL decides which service is
# called, so an OpenRouter key with an anthropic/* model reaches Claude.
MERIDIAN_LLM_PROVIDER=openai_compatible
MERIDIAN_LLM_MODEL=anthropic/claude-sonnet-4.5
MERIDIAN_LLM_BASE_URL=https://openrouter.ai/api/v1
MERIDIAN_LLM_API_KEY=

# Accepted as a second name for MERIDIAN_LLM_API_KEY, for continuity with
# earlier phases. Set only one of the two.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
